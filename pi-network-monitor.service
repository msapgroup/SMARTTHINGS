[Unit]
Description=Pi Network Monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/pi-network-monitor
Environment=PI_MONITOR_DB=/opt/pi-network-monitor/data/monitor.db
Environment=PI_MONITOR_SCAN_INTERVAL=60
ExecStart=/opt/pi-network-monitor/.venv/bin/python -m app
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
