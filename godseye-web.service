[Unit]
Description=GODSEYE Network Intelligence Web
After=network-online.target godseye-scanner.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/godseye
Environment=GODSEYE_DB=/opt/godseye/data/godseye.db
ExecStart=/opt/godseye/.venv/bin/python -m app
Restart=always
RestartSec=5
User=godseye
Group=godseye
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/godseye/data

[Install]
WantedBy=multi-user.target
